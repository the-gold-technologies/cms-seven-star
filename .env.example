# =========================================================================
# Seven Stars CMS - Environment Configuration Example
# Copy this file to '.env' or '.env.local' and populate with your own credentials.
# IMPORTANT: Never commit actual secret keys or credentials to source control!
# =========================================================================

# Database Connections (PostgreSQL / Supabase)
# DATABASE_URL: Pooler connection string (typically port 6543 with ?pgbouncer=true)
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:6543/<db_name>?pgbouncer=true"

# DIRECT_URL: Direct database connection string for migrations (typically port 5432)
DIRECT_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>"

# Supabase Storage Configuration (for media asset uploads)
NEXT_PUBLIC_SUPABASE_URL="https://<your-project-id>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-supabase-anon-public-key>"

# Authentication Secrets (NextAuth.js / Auth.js v5)
# Generate a secret key using: openssl rand -base64 32
AUTH_SECRET="<your-generated-auth-secret-32-chars>"
NEXTAUTH_SECRET="<your-generated-auth-secret-32-chars>"

# Base URL of the CMS dashboard
NEXTAUTH_URL="http://localhost:3001"

# API CORS Configurations
ALLOWED_ORIGINS="*"

# Base URL of the public customer-facing frontend website
NEXT_PUBLIC_WEBSITE_URL="http://localhost:3000"

# SMTP Email Notification Server Configuration (for customer form submissions)
SMTP_HOST="<smtp-server-host>"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="<smtp-auth-username-or-email>"
SMTP_PASS="<smtp-auth-password-or-app-key>"
SMTP_FROM_EMAIL="<sender-email-address>"
SMTP_FROM_NAME="Seven Stars Pub & Club"
CONTACT_EMAIL="<recipient-enquiry-email-address>"

# Cloudinary Storage Configuration (for media asset uploads)
CLOUDINARY_CLOUD_NAME="seven_star"
CLOUDINARY_API_KEY="<your-cloudinary-api-key>"
CLOUDINARY_API_SECRET="<your-cloudinary-api-secret>"
CLOUDINARY_FOLDER="seven_star"


